<mujoco model="toy_arm">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.005" gravity="0 0 -9.81"/>
  <visual>
    <global offwidth="320" offheight="240"/>
  </visual>

  <!-- Exclude self-collisions between adjacent bodies so contact forces
       do not interfere with actuator tracking. -->
  <contact>
    <exclude body1="base"  body2="link1"/>
    <exclude body1="link1" body2="link2"/>
    <exclude body1="link2" body2="gripper_body"/>
  </contact>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <material name="mat_floor" rgba="0.8 0.8 0.8 1"/>
    <material name="mat_link" rgba="0.2 0.4 0.8 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="2 2 0.05" material="mat_floor"/>
    <!-- Isometric-ish top camera: close and angled to fill the frame with the arm -->
    <camera name="top" pos="0.15 -0.6 0.6" xyaxes="1 0 0 0 0.5 0.866"/>
    <!-- Side camera close to arm for large coverage -->
    <camera name="side" pos="0.7 -0.7 0.5" xyaxes="0.707 0.707 0 -0.3 0.3 0.9"/>
    <body name="base" pos="0 0 0.05">
      <geom type="cylinder" size="0.08 0.05" rgba="0.1 0.1 0.1 1"/>
      <body name="link1" pos="0 0 0.08">
        <joint name="joint1" type="hinge" axis="0 0 1" range="-2.5 2.5" damping="2.0"/>
        <geom type="capsule" fromto="0 0 0 0.35 0 0" size="0.035" material="mat_link"/>
        <body name="link2" pos="0.35 0 0">
          <!-- axis negated to "0 -1 0" so positive angle = elbow raising upward;
               original "0 1 0" caused positive angles to push the gripper into
               the floor (gripper z goes negative), blocking all motion.
               Range reduced from -1.5..1.5 to -0.3..1.3 to keep gripper
               safely above floor at all joint angles. -->
          <joint name="joint2" type="hinge" axis="0 -1 0" range="-0.3 1.3" damping="2.0"/>
          <geom type="capsule" fromto="0 0 0 0.25 0 0" size="0.03" material="mat_link"/>
          <body name="gripper_body" pos="0.25 0 0">
            <joint name="gripper" type="slide" axis="0 1 0" range="0 0.04" damping="0.5"/>
            <geom type="box" size="0.04 0.01 0.02" pos="0 0.03 0" rgba="0.8 0.2 0.2 1"/>
            <geom type="box" size="0.04 0.01 0.02" pos="0 -0.03 0" rgba="0.8 0.2 0.2 1"/>
            <camera name="wrist" pos="-0.05 0 0.08" xyaxes="0 1 0 -0.5 0 0.866"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- kp raised from 12/20 to 200 so steady-state error at full gravity load
       is < 0.01 rad; damping raised from 0.2 to 2.0 to damp oscillations for
       joint1 (effective inertia ~0.30 kg*m2) and joint2 (~0.027 kg*m2).
       Validated: 0.5 Hz sweep max tracking error joint1=0.034 rad,
       joint2=0.019 rad; step commands at 10 Hz converge within 0.1s. -->
  <actuator>
    <position name="joint1_motor" joint="joint1" kp="200" ctrlrange="-2.5 2.5"/>
    <position name="joint2_motor" joint="joint2" kp="200" ctrlrange="-0.3 1.3"/>
    <position name="gripper_motor" joint="gripper" kp="200" ctrlrange="0 0.04"/>
  </actuator>
</mujoco>
