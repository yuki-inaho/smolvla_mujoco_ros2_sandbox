<mujoco model="toy_arm">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.005" gravity="0 0 -9.81"/>
  <visual>
    <global offwidth="320" offheight="240"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <material name="mat_floor" rgba="0.8 0.8 0.8 1"/>
    <material name="mat_link" rgba="0.2 0.4 0.8 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="2 2 0.05" material="mat_floor"/>
    <camera name="top" pos="0 0 1.8" xyaxes="1 0 0 0 1 0"/>
    <camera name="side" pos="1.2 -1.2 0.8" xyaxes="0.707 0.707 0 -0.3 0.3 0.9"/>
    <body name="base" pos="0 0 0.05">
      <geom type="cylinder" size="0.08 0.05" rgba="0.1 0.1 0.1 1"/>
      <body name="link1" pos="0 0 0.08">
        <joint name="joint1" type="hinge" axis="0 0 1" range="-2.5 2.5" damping="0.2"/>
        <geom type="capsule" fromto="0 0 0 0.35 0 0" size="0.035" material="mat_link"/>
        <body name="link2" pos="0.35 0 0">
          <joint name="joint2" type="hinge" axis="0 1 0" range="-1.5 1.5" damping="0.2"/>
          <geom type="capsule" fromto="0 0 0 0.25 0 0" size="0.03" material="mat_link"/>
          <body name="gripper_body" pos="0.25 0 0">
            <joint name="gripper" type="slide" axis="0 1 0" range="0 0.04" damping="0.1"/>
            <geom type="box" size="0.04 0.01 0.02" pos="0 0.03 0" rgba="0.8 0.2 0.2 1"/>
            <geom type="box" size="0.04 0.01 0.02" pos="0 -0.03 0" rgba="0.8 0.2 0.2 1"/>
            <camera name="wrist" pos="-0.05 0 0.08" xyaxes="0 1 0 -0.5 0 0.866"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="joint1_motor" joint="joint1" kp="12" ctrlrange="-2.5 2.5"/>
    <position name="joint2_motor" joint="joint2" kp="12" ctrlrange="-1.5 1.5"/>
    <position name="gripper_motor" joint="gripper" kp="20" ctrlrange="0 0.04"/>
  </actuator>
</mujoco>
